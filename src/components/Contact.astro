---
import { contact, contactSection } from '../data/site';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: Heading = 'h2' } = Astro.props;
---
<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="contact-intro reveal">
    <span class="eyebrow dark">{contactSection.eyebrow}</span>
    <Heading id="contact-title" class="contact-title">{contactSection.title}<br /><em>{contactSection.titleEmphasis}</em></Heading>
    <p>{contactSection.body}</p>
  </div>
  <div class="contact-card reveal">
    <dl>
      <div><dt>Call</dt><dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      <div><dt>Hours</dt><dd>{contact.hours}</dd></div>
    </dl>
    <div class="contact-actions"><a class="button accent" href={contact.phoneHref}>Call {contact.phoneDisplay}</a><a class="text-link" href={`mailto:${contact.email}`}>Send an email</a></div>
    <p class="contact-note">{contactSection.note}</p>
  </div>
</section>
