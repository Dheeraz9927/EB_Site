---
import { coverageKeys, coverage, checklists, coveragePages } from '../data/coverage';
---
<section id="coverage" class="section coverage">
  <div class="section-heading reveal"><div><span class="eyebrow dark">01 / COVERAGE THAT FITS</span><h2>Your life isn’t one-size-fits-all.<br /><em>Your insurance shouldn’t be either.</em></h2></div><p>Explore the protection that matters to you. We’ll help make the details feel less complicated.</p></div>
  <div class="coverage-tabs reveal" role="tablist" aria-label="Insurance categories">
    {coverageKeys.map((key,index) => <button role="tab" id={`tab-${key}`} aria-controls={`coverage-panel-${key}`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-coverage={key}><span class="tab-number">0{index+1}</span>{checklists[key].title}<span class="tab-plus" aria-hidden="true">+</span></button>)}
  </div>
  {coverageKeys.map((key,index) => <div class="coverage-panel reveal" id={`coverage-panel-${key}`} role="tabpanel" aria-labelledby={`tab-${key}`} tabindex="0" data-panel={key} hidden={index!==0}>
    <div class="coverage-intro"><span class="outline-icon" aria-hidden="true">0{index+1}</span><span class="eyebrow">{coverage[key].label}</span><h3>{coverage[key].title.map((line,i)=><>{i>0 && <br />}{line}</>)}</h3><p>{coverage[key].description}</p><div class="coverage-actions"><button class="button accent" data-open-planner={key}>{coverage[key].cta}</button><a class="text-link" href={`/${coveragePages[key].slug}/`}>More about {coveragePages[key].navLabel.toLowerCase()}</a></div></div>
    <div class="coverage-details"><p class="detail-label">LET’S TALK ABOUT</p><div class="coverage-points">{coverage[key].points.map(([title,description],i)=><div><span>0{i+1}</span><div><h4>{title}</h4><p>{description}</p></div></div>)}</div><p class="coverage-fine">Coverage and eligibility depend on the insurer and policy terms.</p></div>
  </div>)}
</section>
