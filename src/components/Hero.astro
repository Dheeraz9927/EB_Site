---
import { hero } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow"><span class="small-line"></span> {hero.eyebrow}</div>
    <h1 id="hero-title">{hero.title.map(line => <>{line}<br /></>)}<em>{hero.titleEmphasis}</em></h1>
    <p>{hero.body}</p>
    <div class="hero-actions"><a class="button accent" href={hero.primaryCta.href}>{hero.primaryCta.label}</a><a class="text-link" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a></div>
    <div class="hero-foot"><img class="mini-mark" src="/assets/shield-dark.webp" width="299" height="360" alt="" decoding="async" /><div>{hero.footLine}<br /><span>{hero.footSub}</span></div></div>
  </div>
  <div class="hero-visual">
    <img src="/assets/hero-1152.webp" srcset="/assets/hero-768.webp 768w, /assets/hero-1152.webp 1152w, /assets/hero.webp 1536w" sizes="(max-width: 800px) 92vw, 46vw" alt={hero.imageAlt} width="1536" height="1024" fetchpriority="high" />
    <div class="image-shade"></div>
    <div class="image-caption"><span>{hero.caption.label}</span><p>{hero.caption.lines[0]}<br />{hero.caption.lines[1]}</p></div>
    <div class="floating-note"><span class="note-icon" aria-hidden="true">✓</span><div>{hero.note.title}<small>{hero.note.sub}</small></div></div>
  </div>
</section>
