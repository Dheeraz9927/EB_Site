---
import { closing } from '../data/site';
---
<section class="closing">
  <div class="reveal"><span class="eyebrow">{closing.eyebrow}</span><h2>{closing.title}<br /><em>{closing.titleEmphasis}</em></h2><p>{closing.body}</p><button class="button accent" data-open-planner>{closing.cta}</button><small>{closing.small}</small></div>
  <img class="closing-monogram" src="/assets/shield.webp" width="299" height="360" alt="" loading="lazy" decoding="async" />
</section>
