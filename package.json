{
  "name": "elaena-brokers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm test && npm run build",
    "verify:build": "node scripts/verify-build.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "astro": "^7.4.13",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1"
  }
}
